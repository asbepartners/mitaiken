# Playwright E2E用の追加設定。このファイルをコピーして .env.test.local を作り、値を埋める。
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY は .env.local のものをそのまま使うので、
# ここに書く必要はない。

# Supabaseダッシュボード → Settings → API → service_role secret。
# 強い権限を持つ秘密鍵。絶対にコミットしない・アプリ本体のコードには持ち込まない。
SUPABASE_SERVICE_ROLE_KEY=

# 専用のE2Eテストアカウントのメールアドレス。asbepartners@gmail.com は実機
# での手動確認にも使うため、E2E専用の別アドレス(例: info@kokosupport.jp)を
# 割り当てておくと、OTP送信のレート制限を手動確認と取り合わずに済む。
E2E_TEST_EMAIL=info@kokosupport.jp
